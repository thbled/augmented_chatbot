# Nom de l'événement (titre, manifeste PWA, accueil)
VITE_EVENT_NAME=Business Agility Days 2026
# URL de l'API (par défaut /api, même domaine que l'application)
# VITE_API_BASE_URL=/api
# Domaines autorisés pour les photos et logos hébergés hors de l'application (https),
# séparés par des virgules. À ajouter aussi dans `img-src` de la CSP (vercel.json).
# Vide : seules les images servies par l'application (/images/...) s'affichent.
VITE_IMAGE_HOSTS=
# Cible du proxy de développement vers Flask
# VITE_DEV_API_PROXY=http://127.0.0.1:5000
