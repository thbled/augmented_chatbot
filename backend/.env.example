# --- Serveur LLM : WebSocket de la plateforme (si WS_WORKSPACE_ID est renseigné)
#     ou API HTTP compatible OpenAI (LLM_BASE_URL)
LLM_BASE_URL=https://llm.example.com/v1
WS_URL=wss://ws.generative-eu.engine.capgemini.com/
LLM_API_KEY=change-me

# knowledge base id
WS_WORKSPACE_ID= changme

LLM_MODEL=mistral.devstral-2-123b
WS_PROVIDER=bedrock
WS_DOC_LIMIT=10
# Où placer l'historique : text (replié dans le champ `text`, comportement initial)
# ou system (dans le prompt système : `text` ne contient que la question → meilleure recherche RAG)
WS_HISTORY_IN=text
# Journalise les messages WebSocket bruts (diagnostic uniquement, jamais en production)
WS_DEBUG_RAW=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2500
# Routeur + planning + LLM doivent tenir dans le maxDuration Vercel (60 s) : 6 + 4 + 45 < 60
LLM_TIMEOUT_SECONDS=45
# low | medium | high (laisser vide si le serveur ne gère pas ce paramètre)
LLM_REASONING_EFFORT=low
# Paramètres supplémentaires propres au serveur, en JSON (ex. identifiant de la base de connaissances)
# LLM_EXTRA_BODY={"files":[{"type":"collection","id":"xxxx"}]}
LLM_EXTRA_BODY=

# --- Événement ---
EVENT_NAME=Nom de la conférence
EVENT_TIMEZONE=Europe/Paris
# Développement uniquement (laisser vide en production) :
# jour simulé, l'heure reste réelle ; le planning REST de test (daté du jour réel) est
# décalé sur ce jour.
EVENT_FAKE_DATE=2026-11-18
# instant simulé complet (prioritaire sur EVENT_FAKE_DATE), ex. 2026-11-18T14:30
EVENT_FAKE_NOW=

# --- Planning en direct (API REST de la régie, GET sans authentification) ---
PLANNING_URL=https://planning.example.com/slots?id=e77cfeec-...
# Durée de mise en cache de la réponse, en secondes
PLANNING_TTL_SECONDS=30

# --- Garde-fou n°1 (filtre déterministe avant l'appel au LLM) ---
GUARD_ENABLED=true

# --- Garde-fou LAYA (optionnel, local, CPU) : détection des tentatives de manipulation ---
# Prérequis : `uv sync --extra laya` puis `uv run python scripts/download_laya_model.py --variant english`
# Vide = désactivé. Variante recommandée : anglaise (la multilingue produit trop de faux positifs).
LAYA_MODEL_DIR=
# Score de manipulation au-delà duquel la question est refusée (0,8 : aucun faux positif mesuré)
LAYA_THRESHOLD=0.8
# Threads d'inférence (0 = automatique ; 1 = comportement d'1 vCPU Vercel)
LAYA_THREADS=0

# --- Garde-fou n°2 : routeur (petit modèle, appel sans RAG) — vide = désactivé ---
# Classe la question (périmètre / hors sujet / manipulation) et la reformule pour la recherche.
ROUTER_MODEL=amazon.nova-lite-v1:0
ROUTER_TIMEOUT_SECONDS=6
# Confiance minimale pour refuser ; en deçà, la question passe
ROUTER_REJECT_CONFIDENCE=0.8
# Messages d'historique transmis au routeur pour reformuler (« et elle ? »)
ROUTER_HISTORY_MESSAGES=4
# Fiche de périmètre (noms, thématiques) ; vide = src/chatbot_api/data/scope.json,
# généré par `conference-tools build-kb`
SCOPE_FILE=
# Développement : décisions des garde-fous dans les en-têtes HTTP (X-Guard, X-Router-*)
DEBUG_HEADERS=false

# --- Historique envoyé au LLM ---
# Toute la conversation est transmise ; 0 = pas de limite en nombre de messages
MAX_HISTORY_MESSAGES=0
# Plafond de taille (caractères) : les échanges les plus anciens sont retirés au-delà
MAX_HISTORY_CHARS=60000
# Dans la copie envoyée au LLM uniquement, remplace le JSON des cartes des anciennes réponses
# par un repère court « [fiche speaker : Nom] » (l'affichage dans l'application ne change pas)
HISTORY_COMPACT_CARDS=true
MAX_USER_MESSAGE_CHARS=2000

# --- Limitation par IP (désactivée en développement) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=86400
# Sel pour l'empreinte des IP (chaîne aléatoire en production)
IP_HASH_SALT=
# Redis Upstash (compteur partagé entre instances Vercel). Renseignés automatiquement
# par l'intégration Upstash de Vercel (KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CORS (inutile si frontend et API sont servis sur le même domaine) ---
CORS_ORIGINS=
